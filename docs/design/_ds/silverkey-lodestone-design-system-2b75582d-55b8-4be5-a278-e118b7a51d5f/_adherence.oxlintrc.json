{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/agents/**",
              "components/analysis/**",
              "components/charts/**",
              "components/chrome/**",
              "components/core/**",
              "components/data/**",
              "ui_kits/binmap-cli/**",
              "ui_kits/binmap-desktop/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|IBM Plex Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Poppins, IBM Plex Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AcpAgentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|vendor|command|state|version|protocol|capabilities|authNote|selected|onSelect|onConnect|onLogin|error|style|key|ref|className|style|children)$/]",
        "message": "<AcpAgentCard> doesn't accept that prop. Declared props: name, vendor, command, state, version, protocol, capabilities, authNote, selected, onSelect, onConnect, onLogin, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AcpAgentCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:connected|installed|needsLogin|missing|error)$/]",
        "message": "<AcpAgentCard> state must be one of 'connected' | 'installed' | 'needsLogin' | 'missing' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApiKeyField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|stored|fingerprint|envVar|keyring|onTest|status|onClear|style|key|ref|className|style|children)$/]",
        "message": "<ApiKeyField> doesn't accept that prop. Declared props: value, onChange, placeholder, stored, fingerprint, envVar, keyring, onTest, status, onClear, style."
      },
