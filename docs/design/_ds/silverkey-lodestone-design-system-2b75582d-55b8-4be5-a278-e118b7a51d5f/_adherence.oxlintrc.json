        "selector": "JSXOpeningElement[name.name='ApiKeyField'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:idle|testing|valid|invalid)$/]",
        "message": "<ApiKeyField> status must be one of 'idle' | 'testing' | 'valid' | 'invalid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|mono|outline|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, mono, outline, style."
