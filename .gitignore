/target
Cargo.lock.bak
corpus/*/target
corpus/*/*/target
proptest-regressions/
crates/*/tests/*.proptest-regressions

# The web corpus builds into dist/ and installs esbuild into node_modules/.
# Both are reproducible from package.json, and dist/ holds a hashed chunk name
# that changes with the content.
corpus/web/node_modules/
corpus/web/dist/
corpus/web-heavy/node_modules/
corpus/web-heavy/dist/

# Crash-analysis fixtures: megabytes each, and only meaningful beside the exact
# binary that produced them. `corpus/crasher/capture.sh` regenerates the pair.
corpus/crasher/cores/
corpus/crasher/target/
